<html>
<head>
    <meta http-equiv="x-ua-compatible" content="ie=edge">

    <title>FatChing Studio f Pages Setup</title>
    
    <hta:application 
        id="oApp"
        applicationname="fPages"
        border="thick"
        borderstyle="normal"
        caption="yes"
        icon=""
        maximizebutton="no"
        minimizebutton="yes"
        showintaskbar="yes"
        singleinstance="no"
        sysmenu="yes"
        version="1.0"
        windowstate="normal"
    />

<script>
var currentActiveUrl = "https://xfatching.pages.dev/f/Search.aspx";
</script>

<script type="text/javascript">
function checkIframeLoad(iframe) {
    try {
        var doc = iframe.contentDocument || iframe.contentWindow.document;
        if (doc.body.innerHTML === "" || doc.body.innerHTML === null) {
            throw new Error("Connection Failed");
        }
    } catch (e) {
        console.log("Frame Status: " + e.message);
    }
}

function safeNavigate(url) {
    currentActiveUrl = url;
    // Simply set the src. No pings, no checks, no security blocks.
    var frame = document.getElementById('WebBrowser');
    frame.src = url;
}

window.onload = function() {
    window.resizeTo(785, 768);
    // Wait for the window to finish loading its local resources, then load the web content
    setTimeout(function() {
        safeNavigate("https://xfatching.pages.dev/f/Search.aspx");
    }, 500); // 500ms delay ensures HTA is fully "ready" before loading external content
};
</script>

<title>f Pages - FatChing Studio</title>

<base target="WebBrowser">

<script type="text/javascript">
function updateClock() {
    var now = new Date();
    
    // 手動組裝字串，避免使用不兼容的 toLocaleDateString 選項
    var year = now.getFullYear();
    var month = now.getMonth() + 1;
    var day = now.getDate();
    var hours = now.getHours();
    var minutes = now.getMinutes();
    var seconds = now.getSeconds();

    // 補零函數
    if (minutes < 10) minutes = "0" + minutes;
    if (seconds < 10) seconds = "0" + seconds;

    var timeString = year + "/" + month + "/" + day + "/" + " " + hours + ":" + minutes + ":" + seconds;
    
    // 檢查元素是否存在，避免錯誤
    var clockElement = document.getElementById('live-clock');
    if (clockElement) {
        clockElement.innerHTML = timeString;
    }
}

// 使用 window.setInterval 確保兼容
window.setInterval(updateClock, 1000);
updateClock();
</script>
<style>
      @font-face {
    font-family: "Gill Sans"; /* Name you'll use in CSS */
    src: url("./fonts/Gill Sans.otf") format("opentype"),
         url("./fonts/Gill Sans.otf") format("opentype"); /* Path relative to your CSS file */
    font-weight: normal;
    font-style: normal;
    font-display: swap; /* Optional, helps with performance */
  }

      @font-face {
    font-family: "Gill Sans MT"; /* Name you'll use in CSS */
    src: url("./fonts/Gill Sans Medium.otf") format("opentype"),
         url("./fonts/Gill Sans Medium.otf") format("opentype"); /* Path relative to your CSS file */
    font-weight: normal;
    font-style: normal;
    font-display: swap; /* Optional, helps with performance */
  }

  body {
      font-family: 'Gill Sans', sans-serif;
      color: #000000;
  }

  p {
      font-family: 'Gill Sans', sans-serif;
      color: #000000;
      font-style: normal;
  }

  a {
      font-family: 'Gill Sans', sans-serif;
      color: #0000ff;
      font-style: normal;
  }

  label {
      font-family: 'Gill Sans', sans-serif;
      color: #000000;
      font-style: normal;
  }

  .mt {
      font-family: 'Gill Sans MT', sans-serif;
      color: #000000;
      font-style: normal;
  }
</style>

<script type="text/javascript">
document.onkeydown = function(e) {
    var evt = window.event ? window.event : e;

    // Ctrl + W (Change URL)
    if (evt.ctrlKey && evt.keyCode == 87) {
        evt.returnValue = false;
        if (evt.preventDefault) evt.preventDefault();
    
        var userUrl = prompt("Enter the URL to display: (We are not support open website what have dynamic scripts or X-Frame-Option)", "https://");
    
        if (userUrl !== null && userUrl !== "") {
            // Translate the keyword
            if (userUrl.toLowerCase() === "Start") {
               userUrl = "https://xfatching.pages.dev/f/Search.aspx";
            }
            if (userUrl.toLowerCase() === "start") {
               userUrl = "https://xfatching.pages.dev/f/Search.aspx";
            }
            if (userUrl.toLowerCase() === "START") {
               userUrl = "https://xfatching.pages.dev/f/Search.aspx";
            }
            if (userUrl.toLowerCase() === "Setup") {
               userUrl = "https://xfatching.pages.dev/f/Search.aspx";
            }
            if (userUrl.toLowerCase() === "SetUp") {
               userUrl = "https://xfatching.pages.dev/f/Search.aspx";
            }
            if (userUrl.toLowerCase() === "setUp") {
               userUrl = "https://xfatching.pages.dev/f/Search.aspx";
            }
            if (userUrl.toLowerCase() === "setup") {
               userUrl = "https://xfatching.pages.dev/f/Search.aspx";
            }

            if (userUrl.toLowerCase() === "about:Start") {
               userUrl = "https://xfatching.pages.dev/f/Search.aspx";
            }
            if (userUrl.toLowerCase() === "about:Setup") {
               userUrl = "https://xfatching.pages.dev/f/Search.aspx";
            }
            if (userUrl.toLowerCase() === "about:Wiki") {
               userUrl = "https://xiufui.fandom.com/zh-tw";
            }
            if (userUrl.toLowerCase() === "about:f") {
               userUrl = "https://xfatching.pages.dev/f";
            }
            if (userUrl.toLowerCase() === "about:LegacyStart") {
               userUrl = "https://internet-explorer.pages.dev";
            }

            if (userUrl.toLowerCase() === "about:start") {
               userUrl = "https://xfatching.pages.dev/f/Search.aspx";
            }
            if (userUrl.toLowerCase() === "about:setup") {
               userUrl = "https://xfatching.pages.dev/f/Search.aspx";
            }
            if (userUrl.toLowerCase() === "about:wiki") {
               userUrl = "https://xiufui.fandom.com/zh-tw";
            }
            if (userUrl.toLowerCase() === "f") {
               userUrl = "https://xfatching.pages.dev/f";
            }
            if (userUrl.toLowerCase() === "about:f") {
               userUrl = "https://xfatching.pages.dev/f";
            }
            if (userUrl.toLowerCase() === "about:legacyStart") {
               userUrl = "https://internet-explorer.pages.dev";
            }
            if (userUrl.toLowerCase() === "about:Legacystart") {
               userUrl = "https://internet-explorer.pages.dev";
            }
            if (userUrl.toLowerCase() === "about:legacystart") {
               userUrl = "https://internet-explorer.pages.dev";
            }
        
            // Update the iframe
		currentActiveUrl = userUrl;
	        document.getElementById('WebBrowser').src = currentActiveUrl;
	}
    }

    // Ctrl + R (Reload)
    if (evt.ctrlKey && evt.keyCode == 82) {
        evt.returnValue = false;
        if (evt.preventDefault) evt.preventDefault();
        document.getElementById('WebBrowser').src = document.getElementById('WebBrowser').src;
    }

    // Ctrl + T (Show Borderless Clock)
    if (evt.ctrlKey && evt.keyCode == 84) {
        evt.returnValue = false;
        if (evt.preventDefault) evt.preventDefault();

        var shell = new ActiveXObject("WScript.Shell");
        // This launches the HTA as a distinct system process, bypassing address bar rules
        shell.Run("mshta.exe \"" + location.href.substring(0, location.href.lastIndexOf("/")) + "/applications/liveClock.hta\"");
    }

    // F1 (Show Help)
    if (evt.keyCode == 112) {
        evt.returnValue = false;
        if (evt.preventDefault) evt.preventDefault();

        var shell = new ActiveXObject("WScript.Shell");

        // 1. Get the full absolute path of the current HTA file
        var fullPath = document.location.href; 
    
        // 2. Remove "file:///" and convert to standard path format
        var localPath = fullPath.replace(/^file:\/\/\//, "").replace(/\//g, "\\");
    
        // 3. Get the folder path by stripping the HTA filename
        var folderPath = localPath.substring(0, localPath.lastIndexOf("\\") + 1);
    
        // 4. Combine with your help filename
        var helpPath = folderPath + "helpdocumentation.chm";

        // Debugging: uncomment the line below if it still fails to see the path
        // alert("Trying to open: " + helpPath);

        shell.Run("hh.exe \"" + helpPath + "\"");
    }
}
</script>

</head>
