<html>
<head>

    <title>FatChing Studio f Pages Setup</title>
    
    <hta:application 
        id="oApp"
        applicationname="fPages"
        border="thick"
        borderstyle="normal"
        caption="yes"
        icon=""
        maximizebutton="no"
        minimizebutton="yes"
        showintaskbar="yes"
        singleinstance="no"
        sysmenu="yes"
        version="1.0"
        windowstate="normal"
    />

<script type="text/javascript">
    window.onload = function() {
        // Syntax: window.resizeTo(width, height)
        window.resizeTo(785, 768);
    };
</script>

<base target="WebBrowser">

<script type="text/javascript">
function updateClock() {
    var now = new Date();
    
    // 手動組裝字串，避免使用不兼容的 toLocaleDateString 選項
    var year = now.getFullYear();
    var month = now.getMonth() + 1;
    var day = now.getDate();
    var hours = now.getHours();
    var minutes = now.getMinutes();
    var seconds = now.getSeconds();

    // 補零函數
    if (minutes < 10) minutes = "0" + minutes;
    if (seconds < 10) seconds = "0" + seconds;

    var timeString = year + "/" + month + "/" + day + "/" + " " + hours + ":" + minutes + ":" + seconds;
    
    // 檢查元素是否存在，避免錯誤
    var clockElement = document.getElementById('live-clock');
    if (clockElement) {
        clockElement.innerHTML = timeString;
    }
}

// 使用 window.setInterval 確保兼容
window.setInterval(updateClock, 1000);
updateClock();
</script>
<style>
      @font-face {
    font-family: "Gill Sans"; /* Name you'll use in CSS */
    src: url("./fonts/Gill Sans.otf") format("opentype"),
         url("./fonts/Gill Sans.otf") format("opentype"); /* Path relative to your CSS file */
    font-weight: normal;
    font-style: normal;
    font-display: swap; /* Optional, helps with performance */
  }

      @font-face {
    font-family: "Gill Sans MT"; /* Name you'll use in CSS */
    src: url("./fonts/Gill Sans Medium.otf") format("opentype"),
         url("./fonts/Gill Sans Medium.otf") format("opentype"); /* Path relative to your CSS file */
    font-weight: normal;
    font-style: normal;
    font-display: swap; /* Optional, helps with performance */
  }

  body {
      font-family: 'Gill Sans', sans-serif;
      color: #000000;
  }

  p {
      font-family: 'Gill Sans', sans-serif;
      color: #000000;
      font-style: normal;
  }

  a {
      font-family: 'Gill Sans', sans-serif;
      color: #0000ff;
      font-style: normal;
  }

  label {
      font-family: 'Gill Sans', sans-serif;
      color: #000000;
      font-style: normal;
  }

  .mt {
      font-family: 'Gill Sans MT', sans-serif;
      color: #000000;
      font-style: normal;
  }
</style>

<script type="text/javascript">
    document.onkeydown = function(e) {
        var evt = window.event ? window.event : e;

        // Check for Ctrl + W (keyCode 87)
        if (evt.ctrlKey && evt.keyCode == 87) {
            
            // Legacy IE compatibility for preventing default
            evt.returnValue = false; 
            if (evt.preventDefault) evt.preventDefault();
            
            var userUrl = prompt("Enter the URL to display: (We are not support open website what have dynamic scripts or X-Frame-Option)", "https://");
            
            if (userUrl !== null && userUrl !== "") {
                // Get the element by ID
                var frameElement = document.getElementById('WebBrowser');
                
                // Safety check: only update if the element actually exists
                if (frameElement) {
                    frameElement.src = userUrl;
                } else {
                    alert("Error: Could not find the iframe. Make sure it has id='myFrame'.");
		}
	};
	// 2. New Ctrl + R logic (Reload iframe)
	    if (evt.ctrlKey && evt.keyCode == 82) {
	        evt.returnValue = false; // Prevents browser refresh
	        if (evt.preventDefault) evt.preventDefault();
 	       
	        // This reloads the iframe by resetting its src to itself
	        var frame = document.getElementById('WebBrowser');
	        frame.src = frame.src;
                }
            }
        }
</script>

</head>
<body>
      <table>
            <tbody>
                <tr>
                    <td width="275" align="left" valign="top">FATCHING STUDIO</td><td width="600" align="right" valign="top"> <a href="https://xfatching.pages.dev/index.html" traget="WebBrowser">HOME</a> <a href="https://xfatching.pages.dev/xflive/index.htm" traget="WebBrowser">XFLIVE</a> <a href="https://xfatching.pages.dev/f/Default.aspx.html" traget="WebBrowser">f PAGES</a> <a href="https://xfatching.pages.dev/htmlTests/Default.aspx.html" traget="WebBrowser">HTML TESTS</a> <a href="https://xfatching.pages.dev/applet.html" traget="WebBrowser">APPLET</a> <a href="https://xfatching.pages.dev/community.html" traget="WebBrowser">SOCIAL MEDIA</a> </td>
                </tr>
            </tbody>
      </table>
<br>
<iframe name="WebBrowser" id="WebBrowser" width="700" height="570" src="https://xfatching.pages.dev/f/Search.aspx" alt="" frameborder="0"></iframe><br>
</body>
</html>